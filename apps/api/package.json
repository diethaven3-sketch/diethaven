    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.29",
    "@repo/types": "*",
    "bcrypt": "6.0.0",
    "database": "*",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "resend": "^6.28.1",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.29",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "^22.15.3",
    "@types/passport-jwt": "4.0.1",
    "jest": "30.4.2",
    "ms": "2.1.3",
    "ts-jest": "29.4.12",
    "typescript": "5.9.2"
  },
  "jest": {
    "rootDir": "src",
    "testEnvironment": "node",
