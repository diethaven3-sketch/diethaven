// Explicit output path so generation is deterministic regardless of how
// yarn classic hoists @prisma/client across workspaces (it flip-flopped
// between root-hoisted and nested in this package, breaking cross-package
// type identity each time).
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIETITIAN
  PATIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum DietitianApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

// Only ANTHROPOMETRIC is populated in Milestone 1; the rest exist so
// Milestone 2 domains don't require a schema migration to add.
enum AssessmentDomain {
  ANTHROPOMETRIC
  BIOCHEMICAL
  CLINICAL_PHYSICAL
  DIETARY
  ENVIRONMENTAL
  PATIENT_HISTORY
}

enum AuditAction {
  CREATE
  UPDATE
  VIEW
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

// The three IDNT nutrition-diagnosis domains (guideline §4.2.2).
enum DiagnosisDomain {
  INTAKE
  CLINICAL
  BEHAVIORAL_ENVIRONMENTAL
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  RULED_OUT
}

enum InterventionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  DISCONTINUED
}

enum MealType {
  BREAKFAST
  MORNING_SNACK
  LUNCH
  AFTERNOON_SNACK
  DINNER
  EVENING_SNACK
}

// Nigerian Food Exchange List groups (guideline §4.2.3's own examples).
enum ExchangeGroup {
  STARCHES
  LEGUMES
  VEGETABLES
  FRUITS
  FATS
  PROTEINS
}

model User {
  id                     String     @id @default(cuid())
  role                   Role
  name                   String
  email                  String     @unique
  phone                  String?
  passwordHash           String
  status                 UserStatus @default(ACTIVE)
  otpHash                String?
  otpExpiresAt           DateTime?
  resetPasswordHash      String?
  resetPasswordExpiresAt DateTime?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  dietitianProfile DietitianProfile?
  patientProfile   PatientProfile?

  patientsAsDietitian      PatientProfile[] @relation("DietitianPatients")
  assessmentsAsDietitian   Assessment[]     @relation("DietitianAssessments")
  assessmentsAsPatient     Assessment[]     @relation("PatientAssessments")
  diagnosesAsDietitian     Diagnosis[]      @relation("DietitianDiagnoses")
  diagnosesAsPatient       Diagnosis[]      @relation("PatientDiagnoses")
  interventionsAsDietitian Intervention[]   @relation("DietitianInterventions")
  interventionsAsPatient   Intervention[]   @relation("PatientInterventions")
  mealPlansAsDietitian     MealPlan[]       @relation("DietitianMealPlans")
  mealPlansAsPatient       MealPlan[]       @relation("PatientMealPlans")
  auditLogs                AuditLog[]
  invitesSent              Invite[]         @relation("DietitianInvites")
}

model DietitianProfile {
  id             String                  @id @default(cuid())
  userId         String                  @unique
  user           User                    @relation(fields: [userId], references: [id])
  licenseNumber  String
  specialty      String
  facility       String
  approvalStatus DietitianApprovalStatus @default(PENDING)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
}

model PatientProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id])
  dietitianId    String?
  dietitian      User?     @relation("DietitianPatients", fields: [dietitianId], references: [id])
  dateOfBirth    DateTime
  sex            Sex
  contact        String?
  consentStatus  Boolean   @default(false)
  consentGivenAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([dietitianId])
}

model Assessment {
  id          String           @id @default(cuid())
  patientId   String
  patient     User             @relation("PatientAssessments", fields: [patientId], references: [id])
  dietitianId String
  dietitian   User             @relation("DietitianAssessments", fields: [dietitianId], references: [id])
  date        DateTime         @default(now())
  domain      AssessmentDomain
  // e.g. for ANTHROPOMETRIC: { height, weight, bmi }. "Weight history" is the
  // ordered list of a patient's Assessment rows, not a field duplicated here.
  domainData  Json
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  diagnoses Diagnosis[]

  @@index([patientId])
  @@index([dietitianId])
}

// An IDNT PES statement: Problem (diagnostic label) related to Etiology, as
// evidenced by Signs/Symptoms drawn from the assessment (guideline §4.2.2).
model Diagnosis {
  id            String          @id @default(cuid())
  patientId     String
  patient       User            @relation("PatientDiagnoses", fields: [patientId], references: [id])
  dietitianId   String
  dietitian     User            @relation("DietitianDiagnoses", fields: [dietitianId], references: [id])
  // The assessment this diagnosis was drawn from. Nullable so a diagnosis is
  // never lost if it predates a linked assessment record.
  assessmentId  String?
  assessment    Assessment?     @relation(fields: [assessmentId], references: [id])
  domain        DiagnosisDomain
  // Code from the curated IDNT library, or null when the problem is free-text.
  problemCode   String?
  problem       String
  etiology      String
  signsSymptoms String
  // Which assessment fields served as the signs/symptoms evidence, for
  // traceability: [{ assessmentId, domain, field, label, value }].
  evidence      Json
  status        DiagnosisStatus @default(ACTIVE)
  // Always false today — there are no AI features. The column exists because
  // the guideline's entity list defines it, so the Phase 4 AI layer won't need
  // a migration. Nothing in the UI may present a diagnosis as AI-generated
  // while this is false.
  aiGenerated   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  interventions Intervention[]

  @@index([patientId])
  @@index([dietitianId])
  @@index([assessmentId])
}

// A meal plan built from the Nigerian Food Exchange List (guideline §4.2.3).
model MealPlan {
  id             String   @id @default(cuid())
  patientId      String
  patient        User     @relation("PatientMealPlans", fields: [patientId], references: [id])
  dietitianId    String
  dietitian      User     @relation("DietitianMealPlans", fields: [dietitianId], references: [id])
  name           String
  // Ordered meals, each with its timing and exchange-list selections:
  // [{ mealType, time, items: [{ foodExchangeItemId, foodName, exchangeGroup,
  //    portionSize, exchanges }] }]. Food details are copied onto the plan so a
  // later edit to the reference list can't silently rewrite a prescribed plan.
  meals          Json
  calorieTarget  Float?
  carbsTargetG   Float?
  proteinTargetG Float?
  fatTargetG     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  intervention Intervention?

  @@index([patientId])
  @@index([dietitianId])
}

// Nutrition intervention: the care plan answering an accepted diagnosis, with
// an optional meal plan and prescription (guideline §4.2.3).
model Intervention {
  id              String             @id @default(cuid())
  patientId       String
  patient         User               @relation("PatientInterventions", fields: [patientId], references: [id])
  dietitianId     String
  dietitian       User               @relation("DietitianInterventions", fields: [dietitianId], references: [id])
  // Required: every intervention maps to a specific PES problem/etiology.
  diagnosisId     String
  diagnosis       Diagnosis          @relation(fields: [diagnosisId], references: [id])
  carePlanDetails String
  mealPlanId      String?            @unique
  mealPlan        MealPlan?          @relation(fields: [mealPlanId], references: [id])
  // Formal nutrition prescription: { energyKcal, carbsG, proteinG, fatG,
  // restrictions, supplements, notes }.
  prescription    Json?
  status          InterventionStatus @default(ACTIVE)
  // Always false today — see the same note on Diagnosis.aiGenerated.
  aiGenerated     Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([patientId])
  @@index([dietitianId])
  @@index([diagnosisId])
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String
  timestamp  DateTime    @default(now())

  @@index([userId])
  @@index([entityType, entityId])
}

model Invite {
  id          String       @id @default(cuid())
  token       String       @unique
  email       String
  dietitianId String
  dietitian   User         @relation("DietitianInvites", fields: [dietitianId], references: [id])
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  acceptedAt  DateTime?

  @@index([dietitianId])
}

// Admin-managed reference data. Not yet linked to any patient-facing
// meal-planning feature (that's Nutrition Intervention, a later milestone).
model FoodExchangeItem {
  id            String        @id @default(cuid())
  foodName      String
  exchangeGroup ExchangeGroup
  portionSize   String
  calories      Float?
  carbsG        Float?
  proteinG      Float?
  fatG          Float?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([exchangeGroup])
}
